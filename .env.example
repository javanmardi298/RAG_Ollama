# Copy to .env (windows\setup.ps1 does it). .env is in .gitignore: never commit it.
# Direct Claude chat in the control panel (optional; Claude Desktop needs no key here):
ANTHROPIC_API_KEY=
# Optional: LangSmith tracing for the LangChain version (sends synthetic data to LangSmith):
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Optional: reuse WANDS from the product-search project
WANDS_DIR=
